# Copy to ".env" (git-ignored, stays on your computer).

# Your Alfursan login. Optional — you can also just log in by hand once in the
# browser window the server opens (recommended if your account uses OTP).
ALFURSAN_USER=
ALFURSAN_PASS=

# Show the automation browser window (needed for the first login / CAPTCHA).
# Set to true AFTER you've logged in once, to run searches invisibly.
HEADLESS=false

# Port the app listens on.
PORT=3000

# Saudia site (change only for a country-specific site).
SAUDIA_URL=https://www.saudia.com/
