# Copy this file to ".env" and fill in your details.
# The .env file is git-ignored and never leaves your computer.

# Your Saudia Alfursan login (email OR membership number) and password.
# These are OPTIONAL — by default you log in by hand once in the browser
# window (recommended, and required if your account uses OTP/2-factor).
# Fill them only if you want the script to type them for you.
ALFURSAN_USER=
ALFURSAN_PASS=

# Saudia site to use (leave as-is unless you use a country-specific site).
SAUDIA_URL=https://www.saudia.com/

# Default passengers (used when you don't pass --adults on the command line)
ADULTS=1
