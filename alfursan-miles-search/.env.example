# Copy this file to ".env" and fill in your details.
# The .env file is git-ignored and never leaves your computer.

# Your Saudia Alfursan login (email OR membership number) and password.
# These are OPTIONAL — by default you log in by hand once in the browser
# window (recommended, and required if your account uses OTP/2-factor).
# Fill them only if you want the script to type them for you.
ALFURSAN_USER=
ALFURSAN_PASS=

# Saudia site to use (leave as-is unless you use a country-specific site).
SAUDIA_URL=https://www.saudia.com/

# Default passengers (used when you don't pass --adults on the command line)
ADULTS=1

# ── Phone alerts (optional) ────────────────────────────────────────────
# In --watch mode, when award seats appear the tool can message your PHONE
# via Telegram. To set it up (5 minutes, free):
#   1. In Telegram, message @BotFather → /newbot → copy the token it gives.
#   2. Message your new bot once (say "hi") so it can reply to you.
#   3. Open https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy the
#      "id" number under "chat" — that is your chat id.
# Leave these blank to just beep + print in the terminal instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
